{
  "name": "stichting-lumina-collective",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "dev": "next dev",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build public/studio -y && node scripts/copy-studio-static.mjs",
    "build": "npm run studio:build && next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "lucide-react": "1.39.0",
    "next": "^15.5.25",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanity": "^5.28.0",
    "styled-components": "^6.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@sanity/cli": "^6.6.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "@vercel/frameworks": { "js-yaml": "3.15.2" },
    "@sanity/runtime-cli": { "adm-zip": "0.6.0" },
    "@sanity/cli": { "uuid": "11.1.1" },
    "@sanity/uuid": { "uuid": "11.1.1" }
  }
}
