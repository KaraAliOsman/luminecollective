# Site / Cloudflare
NEXT_PUBLIC_SITE_URL=https://stichtingluminacollective.nl

# Sanity CMS
# Create a project at https://www.sanity.io/
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional private tokens for future preview/write flows.
# Do not expose these in client components.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Webhook secret for /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Email / Forms
# Resend is supported by the current implementation.
RESEND_API_KEY=
FORMS_FROM_EMAIL=noreply@stichtingluminacollective.nl

# Destination addresses. Fill only confirmed official addresses.
CONTACT_EMAIL=
VOLUNTEER_EMAIL=
NEWSLETTER_EMAIL=

# Analytics
# Loaded only after analytics consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Cloudflare OpenNext local development
NEXTJS_ENV=development

# Optional future monitoring
SENTRY_DSN=
